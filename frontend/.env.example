NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Sign in with Google ---
# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services > Credentials). Public value,
# safe to expose to the browser - the frontend uses Google Identity Services to get an ID token
# directly, and the backend (GOOGLE_CLIENT_ID, same value) verifies it server-side.
# Add http://localhost:3000 (and your prod origin) under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=918448887306-hi6h0phgpefv2iv3r3d64gf61vdhf8tn.apps.googleusercontent.com

